            logInput.value = '';
            resultBox.style.display = 'none';
            resultContent.textContent = '';
            importedFileName = '';
            fileNameDisplay.textContent = '未选择文件';
            fileBadge.style.display = 'none';
            clearFileBtn.style.display = 'none';
            fileInput.value = '';
            stopTipRotation();
            loadingSpinner.style.display = 'none';
            testResult.className = 'test-result';
            showToast('已清空', 'fa-eraser');
        }

        // ---------- 增强版文件导入 (支持压缩包) ----------
        function handleFileImport(file) {
            if (!file) return;

            const fileExt = file.name.split('.').pop().toLowerCase();
            const isArchive = ['zip', '7z', 'rar', 'gz', 'tar'].includes(fileExt);

            // 显示文件信息
            importedFileName = file.name;
            fileNameDisplay.textContent = file.name;

            if (isArchive) {
                fileBadge.textContent = '📦 压缩包';
                fileBadge.style.display = 'inline-block';
                showToast(`检测到压缩包: ${file.name}，正在尝试读取...`, 'fa-archive');
            } else {
                fileBadge.textContent = '📄 日志文件';
                fileBadge.style.display = 'inline-block';
            }
            clearFileBtn.style.display = 'inline-flex';

            // 读取文件内容
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    if (isArchive) {
                        // 压缩包：尝试读取为文本（如果是文本压缩包），或提示用户解压
                        // 实际上，浏览器无法直接解压，我们检测是否为纯文本压缩包（如 .gz 可能是文本压缩）
                        const content = e.target.result;
                        // 尝试检测是否为可读文本
                        if (content && typeof content === 'string' && content.length > 100) {
                            // 可能是文本内容
                            logInput.value = content;
                            showToast(`成功读取压缩包内容 (${file.name})`, 'fa-check-circle');
                        } else {
                            // 二进制压缩包，提示用户解压
                            showToast('⚠️ 检测到二进制压缩包，请先解压后再导入日志文件', 'fa-exclamation-triangle');
                            // 尝试读取为ArrayBuffer进行更深入检测 (但保持简单)
                            logInput.value = `[压缩包] ${file.name} - 请先解压此文件，然后导入其中的 .txt 或 .log 日志文件。`;
                        }
                    } else {
                        // 普通文本文件
                        const content = e.target.result;
                        if (content && content.length > 0) {
                            logInput.value = content;
                            showToast(`成功导入: ${file.name}`, 'fa-check-circle');
                        } else {
                            showToast('文件为空', 'fa-exclamation-triangle');
                        }
                    }
                } catch (err) {
                    // 如果读取失败，尝试作为文本读取
                    try {
                        const content = e.target.result;
                        if (content && typeof content === 'string') {
                            logInput.value = content;
                            showToast(`成功导入: ${file.name}`, 'fa-check-circle');
                        }
                    } catch (e2) {
                        showToast('读取文件失败: ' + err.message, 'fa-exclamation-triangle');
                    }
                }
            };
            reader.onerror = () => showToast('读取文件失败', 'fa-exclamation-triangle');

            // 根据文件类型选择读取方式
            if (isArchive) {
                // 压缩包先尝试作为文本读取
                reader.readAsText(file);
            } else {
                reader.readAsText(file);
            }
        }

        // ---------- 事件绑定 ----------
        function init() {
            checkDisclaimer();

            loadSettings();

            disclaimerConfirm.addEventListener('click', acceptDisclaimer);
            disclaimerOverlay.addEventListener('click', (e) => {
                if (e.target === disclaimerOverlay) acceptDisclaimer();
            });

            modelPresetSelect.addEventListener('change', function() {
                const val = this.value;
                applyPreset(val);
                saveSettings();
            });

            testBtn.addEventListener('click', testConnection);

            analyzeBtn.addEventListener('click', analyzeLog);
            clearBtn.addEventListener('click', clearAll);
            loadSampleBtn.addEventListener('click', loadSampleLog);

            importFileBtn.addEventListener('click', () => fileInput.click());
            fileInput.addEventListener('change', (e) => {
                if (fileInput.files.length > 0) {
                    handleFileImport(fileInput.files[0]);
                }
                fileInput.value = '';
            });
            clearFileBtn.addEventListener('click', () => {
                importedFileName = '';
                fileNameDisplay.textContent = '未选择文件';
                fileBadge.style.display = 'none';
                clearFileBtn.style.display = 'none';
                showToast('已清除文件关联', 'fa-info-circle');
            });

            // 拖拽导入支持
            const logArea = document.querySelector('.log-area');
            logArea.addEventListener('dragover', (e) => {
                e.preventDefault();
                logArea.style.borderColor = '#1f6bc0';
                logArea.style.background = '#f1f8ff';
            });
            logArea.addEventListener('dragleave', () => {
                logArea.style.borderColor = '#b6cfe5';
                logArea.style.background = '#ffffffcc';
            });
            logArea.addEventListener('drop', (e) => {
                e.preventDefault();
                logArea.style.borderColor = '#b6cfe5';
                logArea.style.background = '#ffffffcc';
                if (e.dataTransfer.files.length > 0) {
                    handleFileImport(e.dataTransfer.files[0]);
                }
            });

            logInput.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    e.preventDefault();
                    analyzeBtn.click();
                }
            });

            [apiKeyInput, modelNameInput, portInput, systemPromptInput, platformSelect, languageSelect].forEach(el => {
                el.addEventListener('input', saveSettings);
                el.addEventListener('change', saveSettings);
            });

            modalCloseBtn.addEventListener('click', closeModal);
            modalSkipBtn.addEventListener('click', suppressModal);
            supportModal.addEventListener('click', (e) => {
                if (e.target === supportModal) closeModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (supportModal.classList.contains('active')) closeModal();
                    if (disclaimerOverlay.classList.contains('active')) acceptDisclaimer();
                }
            });

            applyPreset(modelPresetSelect.value);
        }

        init();
    })();
</script>
</body>
</html>
