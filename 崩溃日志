<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Minecraft 崩溃日志分析 · 可换Key</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        }
        body {
            background: #f0f5fc;
            min-height: 100vh;
            padding: 24px 16px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }
        .app-container {
            max-width: 920px;
            width: 100%;
            background: rgba(255,255,255,0.8);
            backdrop-filter: blur(4px);
            border-radius: 48px;
            padding: 32px 28px;
            box-shadow: 0 20px 50px -12px rgba(0,20,40,0.2);
            border: 1px solid rgba(255,255,255,0.6);
        }
        h1 {
            font-size: 2rem;
            font-weight: 600;
            color: #0a2942;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        h1 i { color: #1f6bc0; }
        .subhead {
            color: #2b4b6a;
            margin-bottom: 28px;
            padding: 10px 16px;
            border-left: 4px solid #1f6bc0;
            background: rgba(31,107,192,0.06);
            border-radius: 0 16px 16px 0;
            font-size: 0.95rem;
        }

        /* ===== 配置区域 ===== */
        .settings-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 18px;
            background: #eaf1f9;
            padding: 20px 22px;
            border-radius: 32px;
            border: 1px solid #c9dcec;
            margin-bottom: 28px;
        }
        .settings-grid .field {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .settings-grid .field.full { grid-column: 1 / -1; }
        .settings-grid label {
            font-weight: 500;
            font-size: 0.85rem;
            color: #0a2942;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .settings-grid label i { color: #1f6bc0; width: 18px; }
        .settings-grid input, .settings-grid select {
            padding: 10px 14px;
            border-radius: 40px;
            border: 1px solid #c9dcec;
            background: white;
            font-size: 0.95rem;
            outline: none;
            transition: 0.15s;
            appearance: auto;
        }
        .settings-grid input:focus, .settings-grid select:focus {
            border-color: #1f6bc0;
            box-shadow: 0 0 0 3px rgba(31,107,192,0.15);
        }
        .settings-grid input::placeholder { color: #9ab0c7; }

        /* 模型选择行 */
        .model-selector-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 18px;
            grid-column: 1 / -1;
        }
        .model-selector-row .field { grid-column: auto; }

        /* 平台 + 语言 双列 */
        .selector-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 18px;
            grid-column: 1 / -1;
        }
        .selector-row .field { grid-column: auto; }

        .log-area {
            background: #ffffffcc;
            border: 2px dashed #b6cfe5;
            border-radius: 32px;
            padding: 18px 20px;
            margin-bottom: 16px;
            position: relative;
        }
        .log-area textarea {
            width: 100%;
            height: 200px;
            border: none;
            background: transparent;
            resize: vertical;
            font-family: 'JetBrains Mono', 'Menlo', monospace;
            font-size: 0.85rem;
            line-height: 1.6;
            color: #0a2942;
            outline: none;
        }
        .log-area textarea::placeholder { color: #9ab0c7; }

        .file-import-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
            padding: 0 4px;
        }
        .file-import-row .btn {
            padding: 8px 20px;
            font-size: 0.9rem;
        }
        .file-import-row .file-name {
            color: #1f6bc0;
            font-weight: 500;
            font-size: 0.9rem;
            background: #eaf1f9;
            padding: 4px 16px;
            border-radius: 40px;
            border: 1px solid #c9dcec;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 200px;
        }
        .file-import-row .file-badge {
            font-size: 0.7rem;
            background: #d4e3f0;
            padding: 2px 12px;
            border-radius: 40px;
            color: #1a4b75;
        }
        #fileInput { display: none; }

        .action-row {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 22px;
            justify-content: center;
        }
        .btn {
            border: none;
            padding: 12px 28px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: white;
            border: 1px solid #d0dfec;
            color: #1a3b54;
            cursor: pointer;
            transition: 0.15s;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        }
        .btn i { font-size: 1rem; }
        .btn-primary { background: #1a4b75; border-color: #1a4b75; color: white; }
        .btn-primary:hover { background: #0f3a5c; transform: scale(1.02); }
        .btn-primary:disabled { opacity: 0.5; pointer-events: none; }
        .btn-success { background: #1f8b4c; border-color: #1f8b4c; color: white; }
        .btn-success:hover { background: #16733e; transform: scale(1.02); }
        .btn-outline { background: transparent; }
        .btn-outline:hover { background: #e3eef9; }
        .btn-danger { background: #b13e3e; border-color: #b13e3e; color: white; }
        .btn-danger:hover { background: #8f2e2e; }
        .btn-warning { background: #d48c2c; border-color: #d48c2c; color: white; }
        .btn-warning:hover { background: #b87622; transform: scale(1.02); }
        .btn-warning i { color: white; }

        /* 测试结果横幅 */
        .test-result {
            display: none;
            padding: 12px 20px;
            border-radius: 28px;
            margin-bottom: 16px;
            font-weight: 500;
            align-items: center;
            gap: 12px;
            border: 1px solid transparent;
        }
        .test-result.show { display: flex; }
        .test-result.success {
            background: #e6f7ed;
            border-color: #87d4a8;
            color: #0f6e3a;
        }
        .test-result.error {
            background: #fde8e8;
            border-color: #f5a3a3;
            color: #a13535;
        }
        .test-result.loading {
            background: #eaf1f9;
            border-color: #b6cfe5;
            color: #1a4b75;
        }
        .test-result i { font-size: 1.2rem; }

        .result-box {
            background: #f8fcff;
            border-radius: 28px;
            padding: 20px 24px;
            border: 1px solid #c9dcec;
            margin-top: 8px;
            display: none;
            flex-direction: column;
            gap: 12px;
        }
        .result-box .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .result-box .header h3 { font-weight: 600; color: #0a2942; font-size: 1.1rem; }
        .result-box .header .badge {
            background: #d4e3f0;
            padding: 4px 16px;
            border-radius: 40px;
            font-size: 0.8rem;
            color: #1a3b54;
        }
        .result-box .content {
            background: #edf4fa;
            border-radius: 20px;
            padding: 16px 20px;
            max-height: 360px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-word;
            font-size: 0.92rem;
            line-height: 1.7;
            color: #0a2942;
            border: 1px solid #d7e3ee;
        }
        .result-box .content:empty { display: none; }

        .loading-spinner {
            display: none;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            padding: 16px 0 20px;
            background: #f8fcff;
            border-radius: 32px;
            border: 1px solid #d7e3ee;
            margin: 4px 0 12px;
        }
        .loading-spinner .spinner-row {
            display: flex;
            align-items: center;
            gap: 14px;
            color: #1a4b75;
            font-weight: 500;
        }
        .loading-spinner .spinner-row i {
            font-size: 1.6rem;
            animation: spin 0.9s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        .tip-box {
            background: #eaf3fa;
            border-radius: 28px;
            padding: 14px 24px;
            max-width: 80%;
            text-align: center;
            border-left: 4px solid #e68a2e;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }
        .tip-box .tip-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6f8aa3;
            font-weight: 600;
        }
        .tip-box .tip-content {
            font-size: 1rem;
            color: #0a2942;
            font-weight: 500;
            margin-top: 2px;
        }
        .tip-box .tip-content i {
            color: #e68a2e;
            margin-right: 8px;
        }

        .footer-support {
            margin-top: 32px;
            padding-top: 24px;
            border-top: 2px solid #dce8f2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            text-align: center;
        }
        .footer-support .support-text {
            color: #3e617e;
            font-size: 0.95rem;
            font-weight: 400;
        }
        .footer-support .support-text i {
            color: #e85d5d;
            margin: 0 4px;
        }
        .footer-support .bili-btn {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: #00a1d6;
            color: white;
            padding: 12px 32px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            transition: 0.2s;
            box-shadow: 0 6px 18px -6px #00a1d680;
            border: none;
            cursor: pointer;
        }
        .footer-support .bili-btn:hover {
            background: #0088b3;
            transform: scale(1.04);
            box-shadow: 0 8px 24px -6px #00a1d6b0;
        }
        .footer-support .bili-btn i {
            font-size: 1.6rem;
        }
        .footer-support .bili-btn .btn-text {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            line-height: 1.3;
        }
        .footer-support .bili-btn .btn-text .sub {
            font-weight: 400;
            font-size: 0.7rem;
            opacity: 0.85;
        }

        .support-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            padding: 24px;
            animation: fadeIn 0.3s ease;
        }
        .support-modal-overlay.active { display: flex; }
        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        .support-modal {
            background: white;
            border-radius: 40px;
            max-width: 420px;
            width: 100%;
            padding: 36px 32px 32px;
            box-shadow: 0 30px 80px rgba(0,0,0,0.3);
            position: relative;
            text-align: center;
        }
        .support-modal .close-btn {
            position: absolute;
            top: 14px;
            right: 18px;
            background: none;
            border: none;
            font-size: 1.6rem;
            color: #9ab0c7;
            cursor: pointer;
            transition: 0.15s;
            padding: 4px 8px;
            border-radius: 50%;
            line-height: 1;
        }
        .support-modal .close-btn:hover { color: #1a3b54; background: #f0f5fc; }
        .support-modal .modal-icon { font-size: 3.6rem; color: #e85d5d; margin-bottom: 12px; }
        .support-modal .modal-title { font-size: 1.4rem; font-weight: 700; color: #0a2942; margin-bottom: 8px; }
        .support-modal .modal-desc { color: #3e617e; font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; }
        .support-modal .modal-desc i { color: #e85d5d; }
        .support-modal .modal-bili-btn {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: #00a1d6;
            color: white;
            padding: 14px 32px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            transition: 0.2s;
            box-shadow: 0 6px 18px -6px #00a1d680;
            border: none;
            cursor: pointer;
        }
        .support-modal .modal-bili-btn:hover {
            background: #0088b3;
            transform: scale(1.04);
        }
        .support-modal .modal-bili-btn i { font-size: 1.6rem; }
        .support-modal .modal-skip {
            display: block;
            margin-top: 14px;
            color: #9ab0c7;
            font-size: 0.8rem;
            background: none;
            border: none;
            cursor: pointer;
            text-decoration: underline;
            padding: 4px 12px;
        }
        .support-modal .modal-skip:hover { color: #3e617e; }

        .disclaimer-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 24px;
            animation: fadeIn 0.3s ease;
        }
        .disclaimer-overlay.active { display: flex; }
        .disclaimer-modal {
            background: white;
            border-radius: 40px;
            max-width: 500px;
            width: 100%;
            padding: 40px 36px 32px;
            box-shadow: 0 40px 100px rgba(0,0,0,0.35);
            position: relative;
            text-align: center;
        }
        .disclaimer-modal .disclaimer-icon {
            font-size: 3.2rem;
            color: #e68a2e;
            margin-bottom: 12px;
        }
        .disclaimer-modal h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0a2942;
            margin-bottom: 10px;
        }
        .disclaimer-modal .disclaimer-body {
            color: #3e617e;
            font-size: 0.95rem;
            line-height: 1.8;
            text-align: left;
            margin-bottom: 22px;
            background: #f8fcff;
            padding: 16px 20px;
            border-radius: 20px;
            border: 1px solid #eaf1f9;
        }
        .disclaimer-modal .disclaimer-body ul {
            padding-left: 20px;
            margin: 6px 0;
        }
        .disclaimer-modal .disclaimer-body ul li {
            margin-bottom: 4px;
        }
        .disclaimer-modal .disclaimer-body strong {
            color: #0a2942;
        }
        .disclaimer-modal .checkbox-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 18px;
            font-size: 0.92rem;
            color: #2b4b6a;
            cursor: pointer;
        }
        .disclaimer-modal .checkbox-row input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #1f6bc0;
            cursor: pointer;
        }
        .disclaimer-modal .btn-primary {
            padding: 14px 48px;
            font-size: 1.05rem;
        }

        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: #1a2f40;
            color: white;
            padding: 14px 28px;
            border-radius: 60px;
            font-weight: 500;
            box-shadow: 0 8px 28px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            gap: 14px;
            z-index: 999;
            transition: 0.2s;
            opacity: 0;
            pointer-events: none;
        }
        .toast.show { opacity: 1; pointer-events: auto; }
        .toast i { color: #6fc9ff; }

        @media (max-width: 600px) {
            .app-container { padding: 20px 14px; }
            .settings-grid { grid-template-columns: 1fr; }
            .settings-grid .field.full { grid-column: 1; }
            .model-selector-row { grid-template-columns: 1fr; }
            .selector-row { grid-template-columns: 1fr; }
            .file-import-row .file-name { max-width: 120px; }
            .tip-box { max-width: 95%; }
            .footer-support .bili-btn {
                padding: 10px 24px;
                font-size: 0.9rem;
                width: 100%;
                justify-content: center;
            }
            .support-modal { padding: 28px 20px 24px; }
            .disclaimer-modal { padding: 28px 20px 24px; }
        }
    </style>
</head>
<body>
<div class="app-container">
    <h1><i class="fas fa-cube"></i> 崩溃日志分析</h1>
    <div class="subhead"><i class="fas fa-robot"></i> 选择AI模型，导入或粘贴日志，一键智能分析</div>

    <!-- ===== 配置区域 ===== -->
    <div class="settings-grid">
        <!-- API Key 可编辑 -->
        <div class="field">
            <label><i class="fas fa-key"></i> API Key</label>
            <input type="password" id="apiKeyInput" placeholder="请输入你的 API Key" value="sk-proj-6B4wR4z1X9fG2kL7pQ3sT8yU5vM2nA6cD0eF1gH2jK3lZ8xY7wV4bN6mP9qR5sT">
        </div>

        <!-- ===== 模型选择 ===== -->
        <div class="field">
            <label><i class="fas fa-microchip"></i> 模型名称</label>
            <input type="text" id="modelNameInput" placeholder="模型名称" value="gpt-4o-mini">
        </div>

        <!-- 模型下拉选择 + 自定义URL -->
        <div class="model-selector-row">
            <div class="field">
                <label><i class="fas fa-list"></i> 选择 AI 服务</label>
                <select id="modelPresetSelect">
                    <option value="openai">OpenAI (GPT-4o / GPT-4o-mini)</option>
                    <option value="openai-gpt3">OpenAI (GPT-3.5-turbo)</option>
                    <option value="deepseek">DeepSeek</option>
                    <option value="gemini">Google Gemini</option>
                    <option value="claude">Anthropic Claude</option>
                    <option value="qwen">通义千问 (Qwen)</option>
                    <option value="glm">智谱 GLM-4</option>
                    <option value="moonshot">月之暗面 Moonshot</option>
                    <option value="custom">🔧 其他（自定义）</option>
                </select>
            </div>
            <div class="field">
                <label><i class="fas fa-plug"></i> API URL</label>
                <input type="text" id="portInput" placeholder="https://api.openai.com/v1/chat/completions" value="https://api.openai.com/v1/chat/completions">
            </div>
        </div>

        <!-- ===== 平台 + 语言 ===== -->
        <div class="selector-row">
            <div class="field">
                <label><i class="fas fa-mobile-alt"></i> 运行平台</label>
                <select id="platformSelect">
                    <option value="自动识别（从日志中推断）">🔍 自动识别</option>
                    <option value="Windows PC（Java版/Forge/Fabric）">🖥️ Windows</option>
                    <option value="Android 手机（FCL / 澪 / 启动器）">📱 Android</option>
                    <option value="iOS 手机（PojavLauncher / 其他）">📱 iOS</option>
                    <option value="macOS">🍎 macOS</option>
                    <option value="Linux">🐧 Linux</option>
                </select>
            </div>
            <div class="field">
                <label><i class="fas fa-globe"></i> 输出语言</label>
                <select id="languageSelect">
                    <option value="简体中文">🇨🇳 简体中文</option>
                    <option value="日本語">🇯🇵 日本語</option>
                    <option value="English">🇬🇧 English</option>
                    <option value="Español">🇪🇸 Español</option>
                </select>
            </div>
        </div>

        <!-- 系统提示 -->
        <div class="field full">
            <label><i class="fas fa-user"></i> 系统提示</label>
            <input type="text" id="systemPromptInput" placeholder="你是一个Minecraft专家..." value="你是一个Minecraft崩溃分析专家，请根据崩溃日志给出可能的原因和解决方案。">
        </div>
    </div>

    <!-- ===== 测试结果横幅 ===== -->
    <div class="test-result" id="testResult">
        <i class="fas fa-check-circle" id="testIcon"></i>
        <span id="testMessage">连接成功！</span>
    </div>

    <!-- 日志输入 + 导入文件 -->
    <div class="file-import-row">
        <button class="btn btn-outline" id="importFileBtn"><i class="fas fa-file-import"></i> 导入文件</button>
        <span class="file-name" id="fileNameDisplay">未选择文件</span>
        <span class="file-badge" id="fileBadge" style="display:none;"></span>
        <button class="btn btn-outline" id="clearFileBtn" style="display:none;"><i class="fas fa-times"></i> 清除文件</button>
        <input type="file" id="fileInput" accept=".txt,.log,.crash,.zip,.7z,.rar,.gz,.tar,.tar.gz,.tgz">
    </div>

    <div class="log-area">
        <textarea id="logInput" placeholder="在此粘贴 Minecraft 崩溃日志 (latest.log, crash-report) ... 或点击上方「导入文件」按钮导入支持的文件格式"></textarea>
    </div>

    <!-- 操作按钮 -->
    <div class="action-row">
        <button class="btn btn-warning" id="testBtn"><i class="fas fa-vial"></i> 测试连接</button>
        <button class="btn btn-outline" id="clearBtn"><i class="fas fa-eraser"></i> 清空</button>
        <button class="btn btn-outline" id="loadSampleBtn"><i class="fas fa-file-alt"></i> 示例日志</button>
        <button class="btn btn-primary" id="analyzeBtn"><i class="fas fa-brain"></i> 分析</button>
    </div>

    <!-- ===== 加载状态 ===== -->
    <div class="loading-spinner" id="loadingSpinner">
