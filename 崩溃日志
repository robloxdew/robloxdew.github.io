        // ---------- 分析次数统计 ----------
        const ANALYSIS_COUNT_KEY = 'mc_analyzer_analysis_count';
        const SUPPRESS_MODAL_KEY = 'mc_analyzer_suppress_modal_until';

        function getAnalysisCount() {
            try { return parseInt(localStorage.getItem(ANALYSIS_COUNT_KEY)) || 0; } catch { return 0; }
        }
        function incrementAnalysisCount() {
            const count = getAnalysisCount() + 1;
            try { localStorage.setItem(ANALYSIS_COUNT_KEY, count.toString()); } catch { /* ignore */ }
            return count;
        }
        function shouldShowSupportModal() {
            const count = getAnalysisCount();
            if (count === 0 || count % 3 !== 0) return false;
            try {
                const suppressUntil = parseInt(localStorage.getItem(SUPPRESS_MODAL_KEY)) || 0;
                if (suppressUntil > count) return false;
            } catch { /* ignore */ }
            return true;
        }
        function suppressModal() {
            const count = getAnalysisCount();
            try { localStorage.setItem(SUPPRESS_MODAL_KEY, (count + 3).toString()); } catch { /* ignore */ }
            closeModal();
        }
        function showModal() {
            supportModal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeModal() {
            supportModal.classList.remove('active');
            document.body.style.overflow = '';
        }

