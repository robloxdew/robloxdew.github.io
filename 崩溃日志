            "在远古城市中，潜行可以避免激活 '幽匿感测体'",
            "用 'F3 + F' 可以调整渲染距离（需要开启）",
            "在沼泽小屋中，女巫会掉落红石、萤石和糖",
            "用 'F3 + C' 可以复制当前坐标到剪贴板（需要按住）"
        ];

        const LANGUAGE_SYSTEM_SUFFIX = {
            '简体中文': '所有回答必须使用简体中文。',
            '日本語': 'すべての回答は日本語で出力してください。',
            'English': 'All responses must be in English.',
            'Español': 'Todas las respuestas deben estar en español.'
        };

        let tipInterval = null;

        // ---------- 工具函数 ----------
        function showToast(msg, icon = 'fa-check-circle', duration = 2500) {
            toastMsg.textContent = msg;
            toast.querySelector('i').className = 'fas ' + icon;
            toast.classList.add('show');
            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => toast.classList.remove('show'), duration);
        }

        function saveSettings() {
            try {
                localStorage.setItem('mc_analyzer_apiKey', apiKeyInput.value);
                localStorage.setItem('mc_analyzer_model', modelNameInput.value);
                localStorage.setItem('mc_analyzer_port', portInput.value);
                localStorage.setItem('mc_analyzer_preset', modelPresetSelect.value);
                localStorage.setItem('mc_analyzer_system', systemPromptInput.value);
                localStorage.setItem('mc_analyzer_platform', platformSelect.value);
                localStorage.setItem('mc_analyzer_language', languageSelect.value);
            } catch (e) { /* ignore */ }
        }

        function loadSettings() {
            try {
                const key = localStorage.getItem('mc_analyzer_apiKey');
                const model = localStorage.getItem('mc_analyzer_model');
                const port = localStorage.getItem('mc_analyzer_port');
                const preset = localStorage.getItem('mc_analyzer_preset');
                const sys = localStorage.getItem('mc_analyzer_system');
                const platform = localStorage.getItem('mc_analyzer_platform');
                const lang = localStorage.getItem('mc_analyzer_language');
                if (key) apiKeyInput.value = key;
                if (model) modelNameInput.value = model;
                if (port) portInput.value = port;
                if (preset) modelPresetSelect.value = preset;
                if (sys) systemPromptInput.value = sys;
                if (platform) platformSelect.value = platform;
                if (lang) languageSelect.value = lang;
                applyPreset(modelPresetSelect.value);
            } catch (e) { /* ignore */ }
        }

        function applyPreset(presetKey) {
            const preset = MODEL_PRESETS[presetKey];
            if (!preset) return;
            if (presetKey === 'custom') return;
            if (preset.url) portInput.value = preset.url;
            if (preset.model) modelNameInput.value = preset.model;
        }

        function getConfig() {
            return {
                apiKey: apiKeyInput.value.trim(),
                model: modelNameInput.value.trim(),
                port: portInput.value.trim(),
                systemPrompt: systemPromptInput.value.trim() || '你是一个Minecraft崩溃分析专家，请根据崩溃日志给出可能的原因和解决方案。',
                platform: platformSelect.value,
                language: languageSelect.value
            };
        }

        // ---------- 测试连接 ----------
        async function testConnection() {
            const config = getConfig();

            if (!config.apiKey) {
                showTestResult(false, '❌ 请填写 API Key');
                return;
            }
            if (!config.model) {
                showTestResult(false, '❌ 请填写模型名称');
                return;
            }
            if (!config.port || !config.port.startsWith('http')) {
                showTestResult(false, '❌ 请填写有效的 API URL（含协议）');
                return;
            }

            showTestResult('loading', '⏳ 正在测试连接，请稍候...');
            testBtn.disabled = true;

            try {
                const testMessages = [
                    { role: 'system', content: '你是一个助手。' },
                    { role: 'user', content: '回复"OK"表示连接正常。' }
                ];

                const response = await fetch(config.port, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${config.apiKey}`
                    },
                    body: JSON.stringify({
                        model: config.model,
                        messages: testMessages,
                        temperature: 0.1,
                        max_tokens: 10
                    })
                });

                if (!response.ok) {
                    let errMsg = `HTTP ${response.status}`;
                    try {
                        const errData = await response.json();
                        errMsg = errData.error?.message || errMsg;
                    } catch (e) { /* ignore */ }
                    throw new Error(`❌ 连接失败: ${errMsg}`);
                }

                const data = await response.json();
                const reply = data.choices?.[0]?.message?.content || data.choices?.[0]?.text || '';
                if (reply.includes('OK') || reply.includes('ok') || reply.trim()) {
                    showTestResult(true, '✅ 连接成功！AI 服务正常工作 🎉');
                } else {
                    showTestResult(true, '✅ 连接成功，但返回内容异常。请尝试分析日志。');
                }

            } catch (error) {
                console.error('测试错误:', error);
                showTestResult(false, `❌ 测试失败: ${error.message}`);
            } finally {
                testBtn.disabled = false;
            }
        }

        function showTestResult(type, message) {
            testResult.className = 'test-result show';
            testResult.classList.remove('success', 'error', 'loading');
            if (type === 'success' || type === true) {
                testResult.classList.add('success');
                testIcon.className = 'fas fa-check-circle';
            } else if (type === 'error' || type === false) {
                testResult.classList.add('error');
                testIcon.className = 'fas fa-times-circle';
            } else if (type === 'loading') {
                testResult.classList.add('loading');
                testIcon.className = 'fas fa-spinner fa-pulse';
            }
            testMessage.textContent = message;
        }

        // ---------- 小贴士轮播 ----------
        function startTipRotation() {
            const randomIndex = Math.floor(Math.random() * MC_TIPS.length);
            tipContent.innerHTML = `<i class="fas fa-pickaxe"></i> ${MC_TIPS[randomIndex]}`;
            if (tipInterval) clearInterval(tipInterval);
            tipInterval = setInterval(() => {
                const currentText = tipContent.textContent.replace(/[^\w\u4e00-\u9fa5]/g, '');
                let newTip; let attempts = 0;
                do {
                    const idx = Math.floor(Math.random() * MC_TIPS.length);
                    newTip = MC_TIPS[idx];
                    attempts++;
                } while (newTip === currentText && attempts < 20);
                tipContent.innerHTML = `<i class="fas fa-pickaxe"></i> ${newTip}`;
            }, 4000);
        }
        function stopTipRotation() {
            if (tipInterval) { clearInterval(tipInterval); tipInterval = null; }
        }

        // ---------- 核心：分析请求 ----------
        async function analyzeLog() {
            const log = logInput.value.trim();
            if (!log) {
                showToast('请先粘贴日志或导入文件', 'fa-exclamation-triangle');
                return;
            }
            const config = getConfig();
            if (!config.apiKey) {
                showToast('请填写 API Key', 'fa-exclamation-triangle');
                return;
            }
            if (!config.model) {
                showToast('请填写模型名称', 'fa-exclamation-triangle');
                return;
            }
            if (!config.port || !config.port.startsWith('http')) {
                showToast('请填写有效的 API URL (含协议)', 'fa-exclamation-triangle');
                return;
            }

            saveSettings();

            let systemContent = config.systemPrompt;
            const langSuffix = LANGUAGE_SYSTEM_SUFFIX[config.language] || '所有回答必须使用简体中文。';
            systemContent += ' ' + langSuffix;

            let userMessage = `请分析以下Minecraft崩溃日志，指出可能的原因和解决建议：\n\n${log}`;
            if (config.platform && !config.platform.includes('自动识别')) {
                userMessage += `\n\n注意：用户运行在 ${config.platform} 平台，请针对该平台给出具体的排查建议（如文件路径、启动器设置、兼容性注意事项等）。`;
            }

            analyzeBtn.disabled = true;
            loadingSpinner.style.display = 'flex';
            resultBox.style.display = 'none';
            resultContent.textContent = '';
            startTipRotation();

            try {
                const response = await fetch(config.port, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${config.apiKey}`
                    },
                    body: JSON.stringify({
                        model: config.model,
                        messages: [
                            { role: 'system', content: systemContent },
                            { role: 'user', content: userMessage }
                        ],
                        temperature: 0.7,
                        max_tokens: 2000
                    })
                });

                if (!response.ok) {
                    let errMsg = `HTTP ${response.status}`;
                    try {
                        const errData = await response.json();
                        errMsg = errData.error?.message || errMsg;
                    } catch (e) { /* ignore */ }
                    throw new Error(`请求失败: ${errMsg}`);
                }

                const data = await response.json();
                let content = data.choices?.[0]?.message?.content || data.choices?.[0]?.text || data.content || '未获取到分析结果';
                if (!content || content.trim() === '') {
                    content = '模型返回了空内容，请检查配置或重试。';
                }

                resultContent.textContent = content;
                resultBox.style.display = 'flex';
                const platformLabel = config.platform.includes('自动识别') ? '自动' : config.platform.replace(/^[^\s]+\s/,'');
                resultBadge.textContent = `${config.language} · ${platformLabel} · ${config.model}`;
                showToast('分析完成', 'fa-check-circle');

                const newCount = incrementAnalysisCount();
                if (shouldShowSupportModal()) {
                    setTimeout(showModal, 1200);
                }

            } catch (error) {
                console.error('分析错误:', error);
                showToast('分析失败: ' + error.message, 'fa-exclamation-triangle');
            } finally {
                analyzeBtn.disabled = false;
                loadingSpinner.style.display = 'none';
                stopTipRotation();
            }
        }

